<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/khung_lua_chon"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/nen_luyentap_luachon"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/txt_dau_chon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Lựa chọn"
        android:src="@drawable/ic_bullet"
        app:tint="#37659C" />

    <TextView
        android:id="@+id/txt_noi_dung_lua_chon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="@font/juve_normal"
        android:text="Đã thuộc"
        android:textColor="#111111"
        android:textSize="13sp" />

</LinearLayout>