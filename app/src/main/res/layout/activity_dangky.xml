<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f6"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/khung_dang_ky"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="50dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="Logo Kenglish"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_kenglish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tạo tài khoản"
            android:textColor="#202124"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bắt đầu hành trình học từ vựng của bạn"
            android:textColor="#5F6368"
            android:textSize="11sp" />

        <!-- Tên hiển thị -->
        <EditText
            android:id="@+id/edt_ten_hien_thi"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Tên hiển thị"
            android:inputType="textPersonName"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#5F6368"
            android:textColorHint="#A9A9A9"
            android:textSize="11sp" />

        <!-- Email -->
        <EditText
            android:id="@+id/edt_email"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#5F6368"
            android:textColorHint="#A9A9A9"
            android:textSize="11sp" />

        <!-- Mật khẩu -->
        <EditText
            android:id="@+id/edt_mat_khau"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#5F6368"
            android:textColorHint="#A9A9A9"
            android:textSize="11sp" />

        <!-- Xác nhận mật khẩu -->
        <EditText
            android:id="@+id/edt_xac_nhan_mat_khau"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/nen_input_dangnhap"
            android:hint="Xác nhận mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#5F6368"
            android:textColorHint="#A9A9A9"
            android:textSize="11sp" />

        <!-- Submit -->
        <TextView
            android:id="@+id/txt_loi_dang_ky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#C94A4A"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_dang_ky"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/nen_nut_xacnhan"
            android:gravity="center"
            android:text="ĐĂNG KÝ"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Quay về đăng nhập -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Chữ mô tả, không thể bấm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="#5F6368"
                android:textSize="11sp" />

            <!-- Chỉ phần này có thể bấm -->
            <TextView
                android:id="@+id/txt_dang_nhap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Đăng nhập"
                android:textColor="#37659C"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>