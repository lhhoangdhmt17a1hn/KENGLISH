<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <!-- Khung tìm kiếm -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/khung_tra_tu"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/nen_trangchu_tratu"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Icon kính lúp -->
        <ImageView
            android:id="@+id/img_tim_kiem"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:contentDescription="Tìm kiếm"
            android:src="@drawable/ic_kinhlup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <!-- Nhập từ cần tra -->
        <EditText
            android:id="@+id/edt_tra_tu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:fontFamily="@font/juve_normal"
            android:hint="Tra từ vựng..."
            android:inputType="text"
            android:padding="0dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#111111"
            android:textColorHint="#7C8492"
            android:textSize="13sp"

            app:layout_constraintStart_toEndOf="@id/img_tim_kiem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>